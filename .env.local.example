# Copy this file to .env.local (already gitignored) and fill in real values.
# Never commit .env.local.

# Firebase (unchanged)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Mappls business discovery is now server-side through a Firebase Cloud Function.
# No Mappls credential belongs in VITE_ frontend variables.
# Configure MAPPLS_CLIENT_ID and MAPPLS_CLIENT_SECRET in Firebase Secret Manager.
